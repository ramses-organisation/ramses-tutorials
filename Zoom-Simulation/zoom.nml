&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=0
nremap=1
nsubcycle=1,1,1,1,1,2
ncontrol=1
verbose=.false.
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='ICs/level_006'
initfile(2)='ICs/level_007'
initfile(3)='ICs/level_008'
initfile(4)='ICs/level_009'
/

&AMR_PARAMS
levelmin=6
levelmax=10
nexpand=3,3,1,1
ngridtot=6000000
nparttot=6000000
/

&REFINE_PARAMS
m_refine=12*8.,
ivar_refine=0
mass_cut_refine=1.49012e-08
interpol_var=1
interpol_type=0
/

&OUTPUT_PARAMS
aout=1.0
noutput=1
/
