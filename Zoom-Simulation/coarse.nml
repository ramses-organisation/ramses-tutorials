&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=0
nremap=1
nsubcycle=1,1,2
ncontrol=1
verbose=.false.
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='ICs/level_006'
/

&AMR_PARAMS
levelmin=6
levelmax=8
nexpand=1
ngridtot=4000000
nparttot=4000000
/

&REFINE_PARAMS
m_refine=9*8.,
ivar_refine=0
mass_cut_refine=7.62939e-06
interpol_var=1
interpol_type=0
/

&OUTPUT_PARAMS
aout=1.0
noutput=1
/
